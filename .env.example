# Supabase — from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Needed later for admin tasks (creating staff accounts).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payments (Phase 6) — leave blank until merchant credentials exist.
WEBXPAY_MERCHANT_ID=
WEBXPAY_SECRET=
KOKO_MERCHANT_ID=
KOKO_SECRET=

# DN Assist (the AI assistant). Server-only — never expose to the browser.
ANTHROPIC_API_KEY=
PAYABLE_TERMINAL_ID=
PAYABLE_API_KEY=

# Domain. Defaults to dnauto.org — set these only to override, e.g. on staging.
NEXT_PUBLIC_ROOT_DOMAIN=
NEXT_PUBLIC_ALIAS_DOMAINS=
NEXT_PUBLIC_SITE_URL=

# Card terminal.
#
# WEBXPAY have confirmed their terminal has no API we can talk to, so these
# stay empty and the tablet takes the payment method and a signature at
# handover instead. They remain here in case that ever changes.
WEBXPAY_TERMINAL_URL=
WEBXPAY_TERMINAL_KEY=

# Email, via Resend — sending and receiving.
# The from-address must be on a domain verified inside Resend.
RESEND_API_KEY=
RESEND_FROM="DN Auto Repairs <service@send.dnauto.lk>"

# Receiving. Signs the inbound webhook — without it the mailbox refuses to
# accept anything, because there would be no way to tell a real delivery
# from anyone who found the URL.
RESEND_WEBHOOK_SECRET=
